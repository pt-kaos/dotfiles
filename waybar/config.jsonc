// -*- mode: jsonc -*-
// One bar per monitor:
//   * eDP-1 (laptop panel) -> full bar, includes the system tray.
//   * every other output   -> same bar, but "modules-right" is overridden to
//                             drop "tray" so tray icons aren't duplicated.
// Shared definition lives in common.jsonc; keys set here win over the include.
[
    {
        "output": "eDP-1",
        "include": "~/.config/waybar/common.jsonc"
    },
    {
        "output": "!eDP-1",
        "include": "~/.config/waybar/common.jsonc",
        "modules-right": [
            "network",
            "cpu",
            "memory",
            "pulseaudio",
            "pulseaudio/slider",
            "custom/brightness",
            "clock",
            "battery",
            "custom/updates",
            "custom/idleinhibitor",
            "custom/power"
        ]
    }
]
