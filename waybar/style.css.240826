/* ============================================================
 *   GLOBAL FONTS
 * ============================================================ */
* {
    /* `otf-font-awesome` is required to be installed for icons */
    font-family: FontAwesome, Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    padding: 0;
    margin: 0;
}

/* ============================================================
 *   TOOLTIP
 * ============================================================ */
tooltip, .tooltip {
  background: linear-gradient(180deg, #7a9369 0%, #607850 30%, #354c27 70%);
  color: #fff;
  border-radius: 8px;
  padding: 6px 8px;
  box-shadow: none;
}

/* ============================================================
 *   WAYBAR WINDOW CONFIG
 * ============================================================ */
window#waybar {
    /*background-color: rgba(43, 48, 59, 0.5);
    border-bottom: 3px solid rgba(100, 114, 125, 0.5);
    transition-property: background-color;
    transition-duration: .5s; */
  background: rgba(0, 0, 0, 0.7);
  color: #cfcfcf;
  border-radius: 0px;
  border: none;
  padding: 0;
  margin: 0;
}

/* ============================================================
 *   MODULES (Blue Gradient)
 * ============================================================ */
#workspaces,
#clock,
#battery,
#cpu,
#memory,
#network,
#pulseaudio,
#pulseaudio-slider,
#backlight,
#backlight-slider,
#tray,
#idle_inhibitor,
#custom-power {
  font-family: fira-code;
  background: linear-gradient(180deg, #525c50 0%, #464f44 30%, #3a3339 50%, #202820 80%);
}

/* ============================================================
 *   MODULE END CAPS
 * ============================================================ */
#workspaces {
  border-radius: 12px;
}

#custom-power {
  border-top-right-radius: 12px;
  border-bottom-right-radius: 12px;
  font-size: 20px;
  padding: 0 6px 0 6px;
}

#memory {
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}

/* ============================================================
 *   PADDING
 * ============================================================ */
#clock {
  /*border-radius: 24px;*/
  padding: 0 10px;
}

#tray {
  padding-left: 4px;
}

#workspaces,
#battery,
#cpu {
  padding: 0 10px;
  padding-left: 6px;
}

#network {
  padding-right: 8px;
}

#battery.charging {
  padding-right: 4px;
}

#pulseaudio {
  padding-right: 12px;
  padding-left: 6px;
  font-size: 20px;

}

#idle_inhibitor {
  padding: 0 6px;
}

#pulseaudio:hover {
    background-color: #a37800;
}

#mode {
  padding-left: 6px;
  /*  background-color: #64727D;
    box-shadow: inset 0 -3px #ffffff;*/
}

#backlight {
  padding-right: 6px;
  margin: 0 -5px;
  font-size: 15px;
}

#memory {
  padding: 0 6px;
  padding-left: 12px;
}

/* ============================================================
 *   SLIDERS
 * ============================================================ */
#pulseaudio-slider slider,
#backlight-slider slider {
  min-height: 0;
  min-width: 0;
  opacity: 0;
  background-image: none;
  border: none;
  box-shadow: none;
}

#pulseaudio-slider trough,
#backlight-slider trough {
  margin:0px 0;
  min-height: 8px;
  border: none;
  min-width: 10px;
  border-radius: 2px;
  background: transparent;
  box-shadow: none;
}

#pulseaudio-slider highlight,
#backlight-slider highlight {
  min-height: 4px;
  min-width: 10px;
  border: none;
  border-radius: 2px;
  background: linear-gradient(180deg, #cfe9bc 0%, #7a9369 30%, #607850 50%, #354c27 80%);
  /*box-shadow: 0px 0px 3px 0px rgba(255, 255, 255,0.1) inset;*/
}

/* ============================================================
 *   WORKSPACES BUTTONS
 * ============================================================ */
#workspaces button {
  padding: 0;
  margin: 0 3px;
  background: transparent;
  border: none;
  color: #dfdfdf;
  border-radius: 6px;
  transition: all 0.2s ease;
}

